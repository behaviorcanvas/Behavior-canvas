# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet or custom domain (e.g. https://behaviorcanvas.com) is hosted.
APP_URL="https://behaviorcanvas.com"

# RAZORPAY (Primary India & International Payment Gateway — Keep secrets server-side only)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="MY_RAZORPAY_WEBHOOK_SECRET"

# STRIPE (Optional Secondary International Payment Gateway — Keep secrets server-side only)
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="MY_STRIPE_WEBHOOK_SECRET"

# DOWNLOAD_TOKEN_SECRET: Server-side HMAC secret for signing verified resource download URLs
DOWNLOAD_TOKEN_SECRET="CHANGE_TO_RANDOM_LONG_SECRET"

# SMTP EMAIL NOTIFICATIONS (Optional transactional receipts)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="info@behaviorcanvas.com"
SMTP_PASS="MY_SMTP_PASSWORD"
